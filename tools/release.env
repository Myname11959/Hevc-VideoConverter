# -*- sh -*-

# ───── Identità app / naming coerente ─────────────────────────────────────────
APP_ID="hevc-video-converter"                  # usato per bin, .desktop, cartelle in /usr
APP_NAME="HEVC – Video Converter"              # nome visibile all’utente
VERSION_FILE="hevc_gui/VERSION"                # unica fonte (se esiste)
DEFAULT_VERSION="2.0.0"                        # fallback se VERSION non c’è
DEB_REV="1"                                    # revisione Debian (2,3,… per rebuild identici)

# ───── Dipendenze runtime (Debian/Ubuntu) ─────────────────────────────────────
PY_MIN="3.10"
DEB_DEPS="python3 (>= ${PY_MIN}), python3-pyqt5, python3-pyqt5.qtmultimedia, python3-pyqtgraph, python3-numpy, python3-psutil, python3-chardet, ffmpeg"

# ───── Metadati pacchetto ─────────────────────────────────────────────────────
MAINTAINER="Loris Paganini <loris.paganini@gmail.com>"
HOMEPAGE="https://github.com/Myname11959/Hevc-VideoConverter"
DESCRIPTION="HEVC – Video Converter: GUI PyQt5 per ricodifica HEVC/H.265, estrazione audio, sottotitoli e mux."

# ───── Path utili ─────────────────────────────────────────────────────────────
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
DIST_DIR="${ROOT}/dist"
BUILD_DIR="${ROOT}/build"

get_version() {
  if [ -f "${ROOT}/${VERSION_FILE}" ]; then
    tr -d ' \r\n' < "${ROOT}/${VERSION_FILE}"
  else
    printf "%s" "${DEFAULT_VERSION}"
  fi
}

