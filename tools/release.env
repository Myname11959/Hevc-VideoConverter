#!/usr/bin/env bash
set -euo pipefail

# Root del repo (directory parent di tools/)
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

# Id usato nei nomi pacchetti/tarball
APP_ID="hevc-video-converter"

# Output directory per i tarball
DIST_DIR="${ROOT}/dist"

# Legge la versione dal control Debian: "Version: X.Y.Z-N"
# Per i sorgenti usiamo la versione Debian completa X.Y.Z-N
get_version() {
  local control="${ROOT}/pkg/DEBIAN/control"
  if [[ -f "$control" ]]; then
    local v
    v="$(awk -F': ' '$1=="Version"{print $2}' "$control" | head -n1)"

    echo "$v"
    return 0
  fi

  # fallback: se non esiste control, prova una tag git (vX.Y.Z)
  if git -C "$ROOT" describe --tags --match 'v*' >/dev/null 2>&1; then
    git -C "$ROOT" describe --tags --match 'v*' | sed 's/^v//'
    return 0
  fi

  echo "0.0.0"
}
