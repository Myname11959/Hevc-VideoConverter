# ─────────────────────────────
# Backups / duplicates / patch leftovers
# ─────────────────────────────
*.bak
*.bak.*
*.bak_*
*.BAK_*
*.BROKEN_*
*.old
*.orig
*.rej
*~
* (copia).*
* (un'altra copia).*
*_.py

# backup dir: ignora tutto ma lascia il segnaposto
/backup/*
!/backup/.keep

# (se vuoi tenere TRACCIATO backup/_GOLD, sbloccalo così)
# !/backup/_GOLD/
# !/backup/_GOLD/**

# Attic / trash / archive interni al repo
backup/_ATTIC_*/
backup/_TRASH_*/
tools/tools/_ARCHIVE_*/

# ─────────────────────────────
# Packaging / artefacts
# ─────────────────────────────
*.deb
*.tar.gz
*.tgz
*.zip

repo-tree.txt
packaging/
wheelhouse/

# pkg payload (se generata durante build .deb)
pkg/usr/lib/hevc-video-converter/

# ─────────────────────────────
# Coverage / profiling
# ─────────────────────────────
.coverage
.coverage.*
coverage.xml
htmlcov/
.prof
*.prof
*.py,cover

# ─────────────────────────────
# Tests assets generabili (tieni solo il segnaposto)
# ─────────────────────────────
tests/assets/*
!tests/assets/.gitkeep

# ─────────────────────────────
# Qt resources / i18n
# ─────────────────────────────
