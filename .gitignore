hevc_gui/resources/icons_rc.py

# ATTENZIONE: icons.qrc NON la ignoro (di solito è sorgente e deve restare tracciata)
# hevc_gui/resources/icons.qrc

# i18n tmp/backup
hevc_gui/resources/i18n/*.tmp_SAFE_*.ts
hevc_gui/resources/i18n/*.bak_SAFE_*
hevc_gui/resources/i18n/*.bak_*
tools/*.BAK_*


# --- repo cleanup junk ---
*.bak_*
*.BAK_*
*.BROKEN_*
backup/_ATTIC_*/
backup/_TRASH_*/
tools/tools/_ARCHIVE_*/
hevc_gui/resources/i18n/_backup_ts_*/
