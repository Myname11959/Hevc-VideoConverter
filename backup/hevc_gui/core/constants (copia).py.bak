# ------------------------------------------- risoluzioni ---------------------
# Lasciamo i preset principali “neutri” così l’autofix (nel builder) può
# intervenire su 720x576 quando serve.
RESOLUTIONS = {
    "Nessuno": "",
    "576p (720x576)": "scale=720:576",
    "720p (1280x720)": "scale=1280:720",
    "1080p (1920x1080)": "scale=1920:1080",
}

# --- Aspect Ratio / SAR-DAR -------------------------------------------------
# Policy di default per l'aspect quando ricodifichi:
#  - "square"   : forza pixel quadrati (setsar=1) → niente sorprese.
#  - "pal16x9"  : se usi 720x576, imposta 16:9 anamorfico (SAR=64/45).
#  - "preserve" : mantieni il SAR originale (non tocchi niente).
ASPECT_POLICY_DEFAULT = os.getenv("ASPECT_POLICY", "square")

# Valori SAR storici corretti per PAL:
PAL_SAR_4_3 = "16/15"  # 720x576 → 4:3
PAL_SAR_16_9 = "64/45"  # 720x576 → 16:9 (CORRETTO)

# Larghezza massima consigliata (per scale 'min(...)'), se ti serve altrove
WIDTH_CAP_DEFAULT = 1280

# Preset di risoluzione "sicuri" opzionali (non sostituiscono i tuoi esistenti)
SAFE_RESOLUTIONS = {
    # 16:9 con pixel quadrati, altezza 576
    "576p (1024x576) [quadrati]": "scale=1024:576,setsar=1",
    # Mantieni 16:9 con larghezza 720: lascia calcolare l'altezza corretta
    "720 wide (16:9 auto)": "scale=720:-2,setsar=1",
    # PAL anamorfico corretto a 720x576 (display 16:9)
    "576p PAL 16:9 (720x576 anam)": f"scale=720:576,setsar={PAL_SAR_16_9},setdar=16/9",
}

