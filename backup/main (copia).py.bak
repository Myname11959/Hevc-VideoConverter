#!/usr/bin/env python3
import os
import sys

# ⚠️ Imposta l'attributo PRIMA di tutto
from PyQt5.QtCore import QCoreApplication, Qt

QCoreApplication.setAttribute(Qt.AA_DontUseNativeDialogs, True)

# Variabili d’ambiente per qt5ct e logging
os.environ["QT_QPA_PLATFORMTHEME"] = "qt5ct"
os.environ["QT_LOGGING_RULES"] = "qt.qpa.plugin=false"

# Import Qt e progetto
from PyQt5.QtCore import QEvent, QObject
from PyQt5.QtWidgets import QApplication, QWidget
from PyQt5.QtGui import QIcon

from hevc_gui.gui.main_window import MainWindow
from hevc_gui.gui.settings import load_window_size
from hevc_gui.gui.appearance_settings import apply_appearance
from hevc_gui.gui.menubar import apply_large_menu_icons


# FontEnforcer stabile
class FontEnforcer(QObject):
    def __init__(self, font, palette):
        super().__init__()
        self.font = font
        self.palette = palette

    def eventFilter(self, obj, event):
        if event.type() == QEvent.Show and isinstance(obj, QWidget):
            obj.setFont(self.font)
            obj.setPalette(self.palette)
        return super().eventFilter(obj, event)


def main():
    app = QApplication(sys.argv)
    app.setQuitOnLastWindowClosed(True)

    # Imposta l’icona visibile nel pannello di sistema
    icon_path = "/usr/share/icons/hicolor/128x128/apps/hevc-gui.png"
    if os.path.exists(icon_path):
        app.setWindowIcon(QIcon(icon_path))
    else:
        print("⚠️ Icona non trovata:", icon_path)

    apply_appearance(app)

    # Installa FontEnforcer con font/palette aggiornati
    font = app.font()
    palette = app.palette()
    app.installEventFilter(FontEnforcer(font, palette))

    # Crea e mostra la main window
    win = MainWindow()
    w, h = load_window_size()
    win.resize(w, h)
    win.show()

    QApplication.processEvents()
    apply_large_menu_icons(app)
    apply_appearance(app)

    sys.exit(app.exec_())


if __name__ == "__main__":
    main()
