# -*- coding: utf-8 -*-
# Oscilloscopio audio a bassa latenza per HEVC-GUI (PyQt5 + QAudioOutput + pyqtgraph)

import os
os.environ.setdefault("PYQTGRAPH_QT_LIB", "PyQt5")

from typing import List, Optional
from collections import deque
import struct
import wave
import numpy as np
import pyqtgraph as pg

from PyQt5.QtCore import Qt, QIODevice, QTimer
from PyQt5.QtWidgets import (
    QDialog, QWidget, QVBoxLayout, QHBoxLayout, QLabel,
    QPushButton, QSlider, QSizePolicy
)
from PyQt5.QtMultimedia import QAudio, QAudioDeviceInfo, QAudioFormat, QAudioOutput

# ==================== Parametri UI regolabili (via env) ====================
# Larghezza (in px) della colonna delle etichette canale (● + L/R/C…)
# ↑ più grande = etichette meno “schiacciate”; consigliato: 50–90
LABEL_W      = int(os.getenv("HEVC_SCOPE_LABEL_W",   "58"))

# Spazio verticale (in px) tra un frame/onda e il successivo
# 0 = “attaccati”, 4–10 = compatto; consigliato: 4–12
ROW_SPACING  = int(os.getenv("HEVC_SCOPE_VSPACE",    "6"))

# Altezza target (in px) del riquadro nero che contiene la waveform
# ↓ più basso = più canali visibili senza scroll; consigliato: 60–90
PLOT_H       = int(os.getenv("HEVC_SCOPE_WAVE_H",    "72"))

# Altezza massima (in px) consentita per ogni riquadro waveform
# Serve a evitare che il layout lo faccia crescere troppo; tipico: 80–100
PLOT_H_MAX   = int(os.getenv("HEVC_SCOPE_WAVE_MAX",  "86"))

# Dimensioni finestra di default all’avvio (larghezza x altezza in px)
# La finestra si allunga in verticale automaticamente in base ai canali.
SCOPE_DEF_W  = int(os.getenv("HEVC_SCOPE_DEF_W",     "560"))
SCOPE_DEF_H  = int(os.getenv("HEVC_SCOPE_DEF_H",     "318"))

# Altezza (in px) dei bottoni Play/Pause/Stop/«5s/5s»/Chiudi
# Estetica/ergonomia; tipico: 26–34
BTN_H        = int(os.getenv("HEVC_SCOPE_BTN_H",     "30"))

# Altezza (in px) dello slider/seekbar del tempo
# 8–12 è sottile, 14–18 più “grasso”
SLIDER_H     = int(os.getenv("HEVC_SCOPE_SLIDER_H",  "10"))

# Lunghezza del buffer grafico per il disegno delle curve (in campioni)
# ↑ più alto = più “storia” visibile ma costicchia CPU; tipico: 1024–4096
BUF_SAMPLES  = int(os.getenv("HEVC_SCOPE_BUF",       "2048"))

# Dimensione del buffer audio di QAudioOutput (in millisecondi)
# ↓ più basso = latenza più bassa ma rischio di glitch su macchine lente.
# Valori tipici: 30–80 ms. 50ms è un buon compromesso.
AUDIO_MS_BUF = int(os.getenv("HEVC_SCOPE_AUD_MS",    "50"))

# Colori canali (L, R, C, LFE, SL, SR)
COLORS = ["#ffd400", "#00e5ff", "#22c55e", "#f472b6", "#f59e0b", "#60a5fa"]
pg.setConfigOptions(antialias=True)

# --- WAV reader compatibile anche con WAVEFORMATEXTENSIBLE (65534) ---
class _WavReader(object):
    """
    Lettore minimale di WAV PCM (8/16/24/32 bit) che accetta sia
    WAVEFORMATEX (1) che WAVEFORMATEXTENSIBLE (65534).
    Espone una API simile a wave.open() per quello che ci serve.
    """
    def __init__(self, path: str):
        self.f = open(path, 'rb')
        self._parse_header()

    def _ru16(self): return struct.unpack('<H', self.f.read(2))[0]
    def _ru32(self): return struct.unpack('<I', self.f.read(4))[0]

    def _parse_header(self):
        f = self.f
        if f.read(4) != b'RIFF':
            raise ValueError('Not RIFF')
        _riff_size = self._ru32()
        if f.read(4) != b'WAVE':
            raise ValueError('Not WAVE')

        self.channels = None
        self.srate = None
        self.sampwidth = None
        self.blockalign = None
        self.data_offset = None
        self.data_size = 0

        while True:
            ck = f.read(4)
            if not ck:
                break
            sz = self._ru32()
            pos = f.tell()

            if ck == b'fmt ':
                wFormatTag       = self._ru16()
                nChannels        = self._ru16()
                nSamplesPerSec   = self._ru32()
                _avgBytesPerSec  = self._ru32()
                nBlockAlign      = self._ru16()
                wBitsPerSample   = self._ru16()
                if sz > 16:
                    _cbSize = self._ru16()

                # Se Extensible, leggi e scarta il resto; trattalo come PCM
                if wFormatTag == 0xFFFE:
                    need = max(0, min(sz - 18, 22))  # validBits+mask+GUID
                    f.read(need)
                    wFormatTag = 1

                self.channels   = nChannels
                self.srate      = nSamplesPerSec
                self.sampwidth  = max(1, (wBitsPerSample + 7) // 8)
                self.blockalign = nBlockAlign

                f.seek(pos + sz, 0)

            elif ck == b'data':
                self.data_offset = f.tell()
                self.data_size   = sz
                f.seek(pos + sz, 0)
            else:
                f.seek(pos + sz, 0)

            if sz & 1:
                f.seek(1, 1)

        if self.channels is None or self.data_offset is None:
            raise ValueError('WAV header incomplete')

        self.nframes = self.data_size // (self.channels * self.sampwidth)
        self.setpos(0)

    # API stile wave
    def getnchannels(self):  return self.channels
    def getframerate(self):  return self.srate
    def getsampwidth(self):  return self.sampwidth
    def getnframes(self):    return self.nframes

    def setpos(self, frame_index: int):
        frame_index = max(0, min(int(frame_index), self.nframes))
        self.pos = frame_index
        bpf = self.channels * self.sampwidth
        self.f.seek(self.data_offset + frame_index * bpf, 0)

    def readframes(self, n: int) -> bytes:
        n = max(0, int(n))
        to_read = min(n, self.nframes - self.pos)
        bpf = self.channels * self.sampwidth
        data = self.f.read(to_read * bpf)
        self.pos += to_read
        return data

    def close(self):
        try: self.f.close()
        except Exception: pass

def _open_wav_compatible(path: str):
    """Prova wave.open(); se fallisce (es. 65534) usa _WavReader."""
    try:
        return wave.open(path, 'rb')
    except Exception:
        return _WavReader(path)

def _fmt_time(ms: int) -> str:
    if ms is None or ms < 0: return "00:00:00"
    s = ms // 1000
    h = s // 3600; m = (s % 3600) // 60; sec = s % 60
    return f"{h:02d}:{m:02d}:{sec:02d}"

# ================== Riga singolo canale (● + lettera nera + plot) ==================
class _ChannelRow(QWidget):
    def __init__(self, name: str, color: str, parent=None):
        super().__init__(parent)
        hb = QHBoxLayout(self)
        hb.setContentsMargins(0, 0, 0, 0)
        hb.setSpacing(4)

        self.lbl = QLabel(self)
        self.set_label(name, color)
        self.lbl.setAlignment(Qt.AlignVCenter | Qt.AlignLeft)
        self.lbl.setMinimumWidth(40)
        self.lbl.setMaximumWidth(LABEL_W)
        self.lbl.setSizePolicy(QSizePolicy.Fixed, QSizePolicy.Fixed)

        self.plot = pg.PlotWidget(self)
        self.plot.setBackground(pg.mkColor("#0b0b0b"))
        self.plot.setMinimumHeight(PLOT_H)
        self.plot.setMaximumHeight(PLOT_H_MAX)
        self.plot.setSizePolicy(QSizePolicy.Expanding, QSizePolicy.Fixed)
        self.plot.setMouseEnabled(False, False)
        self.plot.hideAxis("bottom"); self.plot.hideAxis("left")
        self.plot.setMenuEnabled(False)
        self.plot.setClipToView(True)
        self.plot.setDownsampling(mode="peak")
        self.plot.setLimits(xMin=0, xMax=BUF_SAMPLES)
        self.plot.setRange(xRange=(0, BUF_SAMPLES), yRange=(-1.0, 1.0), disableAutoRange=True)
        self.plot.setStyleSheet("border:1px solid #666;")

        # Penna sottile — come “foto 2”
        self.color = color
        if os.getenv("HEVC_SCOPE_ZERO_LINE", "0") == "1":
            self.plot.addLine(y=0, pen=pg.mkPen("#444", width=1, cosmetic=True, style=Qt.DotLine))
        self.curve = self.plot.plot(pen=pg.mkPen(color, width=1.3))

        hb.addWidget(self.lbl)
        hb.addWidget(self.plot, 1)

    def set_label(self, name: str, color: str):
        self.lbl.setText(f'<span style="color:{color};">●</span> '
                         f'<span style="color:#000;">{name}</span>')
        self.lbl.setStyleSheet("font-weight:400; margin:0; padding:0;")

# =================== Contenitore multi-canale + buffer curve ===================
class _MultiScope(QWidget):
    def __init__(self, channel_names: List[str], parent=None):
        super().__init__(parent)
        self.channel_names = channel_names or ["L", "R"]
        vb = QVBoxLayout(self)
        vb.setContentsMargins(0, 0, 0, 0)
        vb.setSpacing(ROW_SPACING)

        self.rows: List[_ChannelRow] = []
        self.buffers: List[deque] = []
        for i, nm in enumerate(self.channel_names):
            row = _ChannelRow(nm, COLORS[i % len(COLORS)], self)
            vb.addWidget(row)
            self.rows.append(row)
            self.buffers.append(deque([0.0]*BUF_SAMPLES, maxlen=BUF_SAMPLES))

        # linka gli assi X tra le righe
        for r in self.rows[1:]:
            r.plot.setXLink(self.rows[0].plot)

    def push_samples(self, frame_f32: np.ndarray):
        """frame_f32: shape (N, C) float32 in [-1,1]"""
        if frame_f32.ndim == 1:
            frame_f32 = frame_f32.reshape((-1, 1))
        n, ch = frame_f32.shape
        tgt = min(ch, len(self.buffers))
        for i in range(tgt):
            self.buffers[i].extend(frame_f32[:, i].tolist())
            data = np.fromiter(self.buffers[i], dtype=np.float32, count=BUF_SAMPLES)
            self.rows[i].curve.setData(data if data.size else np.zeros(BUF_SAMPLES, np.float32))

# =================== QIODevice streaming WAV → QAudioOutput ===================
class _WavStream(QIODevice):
    def __init__(self, wav_path: str, scope: _MultiScope, parent=None):
        super().__init__(parent)
        self.wav = _open_wav_compatible(wav_path)  # supporta anche 65534
        self.scope = scope
        self.n_channels  = self.wav.getnchannels()
        self.srate       = self.wav.getframerate()
        self.sampwidth   = self.wav.getsampwidth()  # bytes per sample
        self.n_frames    = self.wav.getnframes()
        self.pos_frames  = 0
        self._open = False

    @property
    def duration_ms(self) -> int:
        return int(1000 * self.n_frames / max(1, self.srate))

    @property
    def position_ms(self) -> int:
        return int(1000 * self.pos_frames / max(1, self.srate))

    def set_position_ms(self, ms: int):
        fr = max(0, min(self.n_frames, int(ms * self.srate / 1000)))
        try:
            self.wav.setpos(fr)
            self.pos_frames = fr
        except Exception:
            pass

    # --- QIODevice overrides ---
    def isSequential(self) -> bool:  return False

    def open(self, mode: QIODevice.OpenMode):
        ok = super().open(mode)
        self._open = True
        return ok

    def close(self):
        self._open = False
        try: self.wav.close()
        except Exception: pass
        super().close()

    def bytesAvailable(self) -> int:
        return (self.n_frames - self.pos_frames) * self.n_channels * self.sampwidth + super().bytesAvailable()

    def readData(self, maxlen: int) -> bytes:
        if not self._open or maxlen <= 0:
            return b""
        bpf = self.n_channels * self.sampwidth
        n = maxlen // bpf
        if n <= 0:
            return b""

        raw = self.wav.readframes(n)
        got = len(raw) // bpf
        self.pos_frames += got

        if raw:
            f32 = self._pcm_to_float32(raw, self.sampwidth, self.n_channels)
            if f32.size:
                self.scope.push_samples(f32)

        return raw

    @staticmethod
    def _pcm_to_float32(raw: bytes, sampwidth: int, ch: int) -> np.ndarray:
        import numpy as _np
        if sampwidth == 1:  # 8-bit unsigned
            arr = _np.frombuffer(raw, dtype=_np.uint8).astype(_np.float32)
            arr = (arr - 128.0) / 128.0
        elif sampwidth == 2:
            arr = _np.frombuffer(raw, dtype=_np.int16).astype(_np.float32) / 32768.0
        elif sampwidth == 3:
            a = _np.frombuffer(raw, dtype=_np.uint8).astype(_np.int32).reshape((-1, 3))
            arr = (a[:, 0] | (a[:, 1] << 8) | (a[:, 2] << 16))
            mask = arr & 0x800000
            arr = (arr | (-(mask != 0) << 24)).astype(_np.int32).astype(_np.float32) / 8388608.0
        else:
            arr = _np.frombuffer(raw, dtype=_np.int32).astype(_np.float32) / 2147483648.0

        if ch > 1:
            n = (arr.size // ch) * ch
            arr = arr[:n].reshape((-1, ch))
        else:
            arr = arr.reshape((-1, 1))
        return arr

# ============================= Dialog principale =============================
class PreviewDialog(QDialog):
    def __init__(self, audio_file: str, parent=None,
                 channel_names: Optional[List[str]] = None,
                 auto_cleanup: bool = False):
        super().__init__(parent)
        self.audio_file   = audio_file
        self.auto_cleanup = bool(auto_cleanup)

        self.scope = _MultiScope(channel_names or ["L", "R"], self)
        self.stream = _WavStream(audio_file, self.scope, self)

        # AudioOutput con formato coerente al WAV (bassa latenza)
        fmt = QAudioFormat()
        fmt.setChannelCount(self.stream.n_channels)
        fmt.setSampleRate(self.stream.srate)
        fmt.setCodec("audio/pcm")
        fmt.setSampleSize(self.stream.sampwidth * 8)
        fmt.setByteOrder(QAudioFormat.LittleEndian)
        fmt.setSampleType(QAudioFormat.UnSignedInt if self.stream.sampwidth == 1 else QAudioFormat.SignedInt)

        dev = QAudioDeviceInfo.defaultOutputDevice()
        if not dev.isFormatSupported(fmt):
            fmt = dev.nearestFormat(fmt)

        self.audio = QAudioOutput(dev, fmt, self)

        # Buffer ~AUDIO_MS_BUF ms (minimo 2 frame audio)
        bytes_per_ms = self.stream.srate * self.stream.n_channels * self.stream.sampwidth // 1000
        min_bytes = max(self.stream.n_channels * self.stream.sampwidth * 2, 1)
        self.audio.setBufferSize(max(bytes_per_ms * max(10, AUDIO_MS_BUF), min_bytes))
        self.audio.setNotifyInterval(20)  # update stato ogni ~20ms

        self._was_playing = False

        self._build_ui()
        self._connect_signals()

        # Geometria “foto 2”
        self.resize(SCOPE_DEF_W, SCOPE_DEF_H)
        QTimer.singleShot(0, self._autosize_height)

        # timer per tempo/slider
        self.tmr = QTimer(self); self.tmr.setInterval(40)
        self.tmr.timeout.connect(self._tick)

    # chiamata da preview.py per rinominare i canali
    def set_channel_layout(self, layout_key: str, channel_names: List[str]):
        if channel_names and len(channel_names) == len(self.scope.rows):
            for i, nm in enumerate(channel_names):
                self.scope.rows[i].set_label(nm, self.scope.rows[i].color)

    # ---------------- UI ----------------
    def _build_ui(self):
        self.setWindowTitle("Preview Audio con Oscilloscopio")
        main = QVBoxLayout(self); main.setContentsMargins(8,8,8,8); main.setSpacing(8)

        main.addWidget(self.scope, 1)

        # seek row
        seek = QHBoxLayout(); seek.setContentsMargins(0,0,0,0); seek.setSpacing(8)
        self.slider = QSlider(Qt.Horizontal, self)
        self.slider.setRange(0, self.stream.duration_ms)
        self.slider.setFixedHeight(SLIDER_H)
        self.slider.setStyleSheet("""
            QSlider::groove:horizontal { height:6px; background:#c0c0c0; margin:2px 0; }
            QSlider::handle:horizontal { width:14px; background:#666; border:1px solid #444; margin:-6px 0; border-radius:3px; }
        """)
        self.lbl_time = QLabel(f"{_fmt_time(0)} / {_fmt_time(self.stream.duration_ms)}", self)
        self.lbl_time.setAlignment(Qt.AlignRight | Qt.AlignVCenter)
        self.lbl_time.setMinimumWidth(150)
        seek.addWidget(self.slider, 1); seek.addWidget(self.lbl_time)
        main.addLayout(seek)

        # bottoni (espansi con margine)
        btns = QHBoxLayout(); btns.setContentsMargins(0,0,0,0); btns.setSpacing(8)
        self.btn_play  = QPushButton("Play", self)
        self.btn_pause = QPushButton("Pause", self)
        self.btn_stop  = QPushButton("Stop", self)
        self.btn_back  = QPushButton("« 5s", self)
        self.btn_fwd   = QPushButton("5s »", self)
        self.btn_close = QPushButton("Chiudi", self)
        for b in (self.btn_play, self.btn_pause, self.btn_stop, self.btn_back, self.btn_fwd, self.btn_close):
            b.setMinimumHeight(BTN_H)
            b.setSizePolicy(QSizePolicy.Expanding, QSizePolicy.Fixed)
            btns.addWidget(b, 1)
        main.addLayout(btns)

    def _connect_signals(self):
        self.btn_play.clicked.connect(self._on_play)
        self.btn_pause.clicked.connect(self._on_pause)
        self.btn_stop.clicked.connect(self._on_stop)
        self.btn_back.clicked.connect(lambda: self._jump(-5000))
        self.btn_fwd.clicked.connect(lambda: self._jump(+5000))
        self.btn_close.clicked.connect(self._on_close)

        self.slider.sliderPressed.connect(self._on_slider_press)
        self.slider.sliderReleased.connect(self._on_slider_release)
        self.slider.sliderMoved.connect(self._on_slider_moved)

        self.audio.stateChanged.connect(self._on_state_changed)

    # ---------------- Player logic (bassa latenza) ----------------
    def _on_play(self):
        st = self.audio.state()
        if st == QAudio.ActiveState:
            return
        if not self.stream.isOpen():
            self.stream.open(QIODevice.ReadOnly)
        if st == QAudio.SuspendedState:
            self.audio.resume()
        else:
            self.audio.start(self.stream)
        self.tmr.start()

    def _on_pause(self):
        if self.audio.state() == QAudio.ActiveState:
            self.audio.suspend()
            self.tmr.stop()

    def _on_stop(self):
        try:
            self.audio.stop()
        except Exception:
            pass
        if self.stream.isOpen():
            try: self.stream.set_position_ms(0)
            except Exception: pass
        self.tmr.stop()
        self._tick(force=True)

    def _on_state_changed(self, st: QAudio.State):
        if st == QAudio.ActiveState:
            self.tmr.start()
        elif st in (QAudio.IdleState, QAudio.StoppedState):
            self.tmr.stop()

    def _jump(self, d_ms: int):
        cur = self.stream.position_ms
        tgt = max(0, min(self.stream.duration_ms, cur + d_ms))
        was = (self.audio.state() == QAudio.ActiveState)
        if was: self.audio.suspend()
        self.stream.set_position_ms(tgt)
        if was: self.audio.resume()
        self._tick(force=True)

    # seek con slider
    def _on_slider_press(self):
        self._was_playing = (self.audio.state() == QAudio.ActiveState)
        if self._was_playing:
            self.audio.suspend()

    def _on_slider_moved(self, v):
        self.lbl_time.setText(f"{_fmt_time(v)} / {_fmt_time(self.stream.duration_ms)}")

    def _on_slider_release(self):
        v = int(self.slider.value())
        self.stream.set_position_ms(v)
        if self._was_playing:
            self.audio.resume()
        self._tick(force=True)

    # aggiornamento UI
    def _tick(self, force: bool=False):
        pos = self.stream.position_ms
        self.slider.blockSignals(True)
        self.slider.setValue(pos)
        self.slider.blockSignals(False)
        self.lbl_time.setText(f"{_fmt_time(pos)} / {_fmt_time(self.stream.duration_ms)}")

    def _on_close(self):
        try: self.audio.stop()
        except Exception: pass
        try: self.stream.close()
        except Exception: pass
        self.accept()

    def closeEvent(self, e):
        try: self.audio.stop(); self.stream.close()
        except Exception: pass
        super().closeEvent(e)

    # altezza automatica per 2/5/6 canali
    def _autosize_height(self):
        n = max(1, len(self.scope.rows))
        wanted = 16 + n*PLOT_H + (n-1)*ROW_SPACING + (BTN_H + SLIDER_H + 64)
        self.resize(max(self.width(), SCOPE_DEF_W), max(SCOPE_DEF_H, wanted))
